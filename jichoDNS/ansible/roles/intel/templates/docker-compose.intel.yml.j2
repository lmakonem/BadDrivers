---
# =============================================================================
# JichoDNS Intel Stack — Dark Web + OSINT Collection
# Managed by Ansible — DO NOT EDIT MANUALLY
# =============================================================================

services:
  tor:
    image: dperson/torproxy:latest
    container_name: intel-tor
    restart: unless-stopped
    networks:
      - intel-net
    command: ""
    mem_limit: 128m
    healthcheck:
      test: ["CMD-SHELL", "curl -s --socks5 localhost:9050 https://check.torproject.org/api/ip || exit 1"]
      interval: 60s
      timeout: 15s
      retries: 3
      start_period: 60s

  torbot:
    image: jichodns-torbot:latest
    container_name: intel-torbot
    restart: "no"
    depends_on:
      tor:
        condition: service_healthy
    networks:
      - intel-net
    volumes:
      - intel-data:/output
      - {{ app_dir }}/intel-config/torbot:/config:ro
    environment:
      - TOR_SOCKS_HOST=tor
      - TOR_SOCKS_PORT=9050
    mem_limit: 256m
    entrypoint: ["sleep", "infinity"]

  spiderfoot:
    image: ctdc/spiderfoot:latest
    container_name: intel-spiderfoot
    restart: unless-stopped
    networks:
      - intel-net
      - jichodns-network
    volumes:
      - spiderfoot-data:/var/lib/spiderfoot
    environment:
      - SF_DEBUG=0
    mem_limit: 512m
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:5001/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

volumes:
  intel-data:
    driver: local
  spiderfoot-data:
    driver: local

networks:
  intel-net:
    driver: bridge
  jichodns-network:
    external: true
    name: jichodns-network
