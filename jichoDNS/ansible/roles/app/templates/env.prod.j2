# =============================================================================
# JichoDNS Production Environment - Managed by Ansible
# DO NOT EDIT MANUALLY - changes will be overwritten on next deploy
# =============================================================================

# Environment
ENVIRONMENT=production
LOG_LEVEL={{ app_log_level }}
SECRET_KEY={{ vault_secret_key }}

# Database credentials
POSTGRES_PASSWORD={{ vault_postgres_password }}
CLICKHOUSE_PASSWORD={{ vault_clickhouse_password }}

# Database URLs (set via docker-compose environment, these are fallbacks)
DATABASE_URL=postgresql://{{ postgres_user }}:{{ vault_postgres_password }}@jichodns-postgres:5432/{{ postgres_db }}
CLICKHOUSE_URL=clickhouse://{{ clickhouse_user }}:{{ vault_clickhouse_password }}@jichodns-clickhouse:9000/{{ clickhouse_db }}
REDIS_URL=redis://:{{ vault_redis_password }}@jichodns-redis:6379/0
ELASTICSEARCH_URL=http://elastic:{{ vault_elasticsearch_password }}@jichodns-elasticsearch:9200

# CORS - allow frontend and direct API access
CORS_ORIGINS=["http://{{ server_ip }}:{{ expose_frontend_port }}", "http://{{ server_ip }}", "http://{{ server_ip }}:{{ expose_http_port }}"]

# External API Keys
RIPE_ATLAS_API_KEY={{ vault_ripe_atlas_api_key }}
SHODAN_API_KEY={{ vault_shodan_api_key }}
VIRUSTOTAL_API_KEY={{ vault_virustotal_api_key }}
OTX_API_KEY={{ vault_otx_api_key }}
ABUSEIPDB_API_KEY={{ vault_abuseipdb_api_key }}
NVD_API_KEY={{ vault_nvd_api_key }}
HIBP_API_KEY={{ vault_hibp_api_key }}
INTELX_API_KEY={{ vault_intelx_api_key }}
WHOISXML_API_KEY={{ vault_whoisxml_api_key }}
DEHASHED_API_KEY={{ vault_dehashed_api_key }}
TELEGRAM_BOT_TOKEN={{ vault_telegram_bot_token }}
CENSYS_API_ID={{ vault_censys_api_id }}
CENSYS_API_SECRET={{ vault_censys_api_secret }}
MALWAREBAZAAR_API_KEY={{ vault_malwarebazaar_api_key }}
WEBHOOK_SIGNING_SECRET={{ vault_webhook_signing_secret }}

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT={{ vault_google_cloud_project }}
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-credentials.json

# Stripe
STRIPE_SECRET_KEY={{ vault_stripe_secret_key }}
STRIPE_WEBHOOK_SECRET={{ vault_stripe_webhook_secret }}
STRIPE_PUBLISHABLE_KEY={{ vault_stripe_publishable_key }}

# Paystack
PAYSTACK_SECRET_KEY={{ vault_paystack_secret_key }}
PAYSTACK_WEBHOOK_SECRET={{ vault_paystack_webhook_secret }}
PAYSTACK_PUBLIC_KEY={{ vault_paystack_public_key }}

# Frontend
MAPBOX_TOKEN={{ vault_mapbox_token }}
NEXT_PUBLIC_API_URL={{ next_public_api_url }}

# Email (SMTP) — empty SMTP_HOST = console mode (emails logged, not sent)
SMTP_HOST={{ smtp_host | default('') }}
SMTP_PORT={{ smtp_port | default(587) }}
SMTP_USERNAME={{ vault_smtp_username | default('') }}
SMTP_PASSWORD={{ vault_smtp_password | default('') }}
EMAIL_FROM={{ email_from | default('no-reply@defendanddetect.com') }}
EMAIL_FROM_NAME=JichoSec
PUBLIC_BASE_URL=https://{{ public_hostname | default('jichosec.defendanddetect.com') }}
REQUIRE_EMAIL_VERIFICATION={{ require_email_verification | default('false') }}
