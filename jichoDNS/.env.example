# =============================================================================
# JichoDNS Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# Database credentials
POSTGRES_PASSWORD=jichodns_dev
CLICKHOUSE_PASSWORD=jichodns_dev

# =============================================================================
# External API Keys
# =============================================================================

# RIPE Atlas (https://atlas.ripe.net/keys/)
RIPE_ATLAS_API_KEY=

# Shodan (https://account.shodan.io/)
SHODAN_API_KEY=

# VirusTotal (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# AlienVault OTX (https://otx.alienvault.com/api)
OTX_API_KEY=

# AbuseIPDB (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=

# NVD CVE API (optional — higher rate limit: https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Have I Been Pwned (https://haveibeenpwned.com/API/Key — $3.50/month)
HIBP_API_KEY=

# Intelligence X (https://intelx.io/product)
INTELX_API_KEY=

# WhoisXML (https://whois.whoisxmlapi.com/)
WHOISXML_API_KEY=

# Dehashed (https://dehashed.com/pricing)
DEHASHED_API_KEY=

# Telegram Bot (https://core.telegram.org/bots — for dark web channel monitoring)
TELEGRAM_BOT_TOKEN=

# Censys (https://search.censys.io/account/api)
CENSYS_API_ID=
CENSYS_API_SECRET=

# Webhook outbound signing secret
WEBHOOK_SIGNING_SECRET=

# =============================================================================
# Google Cloud / Vertex AI
# =============================================================================

# GCP Project ID for Vertex AI
GOOGLE_CLOUD_PROJECT=

# Path to service account JSON (inside container)
# Place your credentials in ./credentials/gcp-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-credentials.json

# =============================================================================
# Payment Providers
# =============================================================================

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PUBLIC_KEY=

# =============================================================================
# Frontend
# =============================================================================

# Mapbox (https://account.mapbox.com/access-tokens/)
MAPBOX_TOKEN=

# API URL (for frontend to reach backend)
NEXT_PUBLIC_API_URL=http://localhost:8000
