# Audit Rules for Mythic IaC Deployment
# Generated by Ansible - Do not edit manually

# Mythic-specific file monitoring
-w {{ mythic_base_path | default('/opt/mythic') }}/payloads -p wa -k mythic_payload_change
-w {{ mythic_base_path | default('/opt/mythic') }}/config -p wa -k mythic_config_change
-w /etc/docker -p wa -k docker_config_change

# Mythic execution monitoring
-a always,exit -F arch=b64 -S execve -F path={{ mythic_base_path | default('/opt/mythic') }} -F auid>=1000 -k mythic_execution

# System call monitoring
-a always,exit -F arch=b64 -S adjtimex -S settimeofday -k time-change
-a always,exit -F arch=b64 -S clock_settime -k time-change

# Network modification monitoring
-a always,exit -F arch=b64 -S sethostname -S setdomainname -k network_modifications
-w /etc/hosts -p wa -k network_modifications
-w /etc/sysconfig/network -p wa -k network_modifications

# User/Group monitoring
-w /usr/sbin/usermod -p x -k usermod
-w /usr/sbin/passwd -p x -k passwd_modification
-w /usr/sbin/groupadd -p x -k group_modification

# Sudoers monitoring
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers

# SSH monitoring
-w /etc/ssh/sshd_config -p wa -k sshd_config

# Login monitoring
-w /var/log/faillog -p wa -k logins
-w /var/log/lastlog -p wa -k logins
-w /var/log/tallylog -p wa -k logins

# Session monitoring
-w /var/run/utmp -p wa -k session
-w /var/log/wtmp -p wa -k logins
-w /var/log/btmp -p wa -k logins

# Make configuration immutable
-e 2
