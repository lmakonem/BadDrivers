# Filebeat Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

filebeat.config.modules:
  path: ${path.config}/modules.d/*.yml
  reload.enabled: false

filebeat.inputs:
  - type: log
    enabled: true
    paths:
{% for path in filebeat_log_paths %}
      - {{ path }}
{% endfor %}
    fields:
      host: {{ ansible_hostname }}
      environment: {{ deployment_mode }}
    fields_under_root: false

# Processors
processors:
  - add_host_metadata: ~
  - add_cloud_metadata: ~
  - add_fields:
      target: mythic
      fields:
        deployment_mode: {{ deployment_mode }}
        role: {% if 'mythic_servers' in group_names %}mythic_server{% elif 'redirectors' in group_names %}redirector{% elif 'monitoring' in group_names %}monitoring{% else %}unknown{% endif %}

# Output to Elasticsearch (configure after deployment)
output.elasticsearch:
  enabled: false
  hosts: ["localhost:9200"]

# Or output to file for lab mode
output.file:
  enabled: true
  path: "/var/log/filebeat"
  filename: "filebeat-%{+yyyy.MM.dd}"
  rotate_every_kb: 10000
  number_of_files: 7

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0644
