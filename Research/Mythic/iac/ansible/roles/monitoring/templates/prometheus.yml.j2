# Prometheus Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}
  external_labels:
    monitor: 'mythic-lab'
    environment: {{ deployment_mode }}

# Alertmanager configuration
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - localhost:9093

# Scrape configurations
scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets:
{% for host in groups.get('all', []) %}
          - {{ hostvars[host].ansible_host | default(host) }}:{{ prometheus_node_exporter_port }}
{% endfor %}

  - job_name: 'docker'
    static_configs:
      - targets:
{% for host in groups.get('mythic_servers', []) %}
          - {{ hostvars[host].ansible_host | default(host) }}:9323
{% endfor %}

  - job_name: 'nginx'
    static_configs:
      - targets:
{% for host in groups.get('redirectors', []) %}
          - {{ hostvars[host].ansible_host | default(host) }}:9113
{% endfor %}

  - job_name: 'mythic_api'
    metrics_path: '/metrics'
    static_configs:
      - targets:
{% for host in groups.get('mythic_servers', []) %}
          - {{ hostvars[host].ansible_host | default(host) }}:{{ mythic_container_port }}
{% endfor %}

{% if groups.get('monitoring', []) %}
  - job_name: 'vault'
    scheme: https
    tls_config:
      insecure_skip_verify: true
    static_configs:
      - targets: ['localhost:8200']
{% endif %}

rule_files:
  - '/etc/prometheus/rules/*.yml'
