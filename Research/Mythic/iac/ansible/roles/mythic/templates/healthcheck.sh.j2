#!/bin/bash
# Mythic Container Health Check Script
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

set -e

MYTHIC_URL="https://localhost:{{ mythic_https_port }}/api"
TIMEOUT=5
RETRIES=3

check_mythic_api() {
    for i in $(seq 1 $RETRIES); do
        if curl -sk --connect-timeout $TIMEOUT --max-time $TIMEOUT "$MYTHIC_URL" >/dev/null 2>&1; then
            echo "✓ Mythic API is responding"
            return 0
        fi
        if [ $i -lt $RETRIES ]; then
            sleep 2
        fi
    done
    echo "✗ Mythic API is not responding"
    return 1
}

check_postgres() {
    if nc -z -w 2 postgres {{ postgres_port }} 2>/dev/null; then
        echo "✓ PostgreSQL is accessible"
        return 0
    else
        echo "✗ PostgreSQL is not accessible"
        return 1
    fi
}

check_rabbitmq() {
    if nc -z -w 2 rabbitmq 5672 2>/dev/null; then
        echo "✓ RabbitMQ is accessible"
        return 0
    else
        echo "✗ RabbitMQ is not accessible"
        return 1
    fi
}

check_httpx() {
    if nc -z -w 2 localhost 82 2>/dev/null; then
        echo "✓ httpx is listening"
        return 0
    else
        echo "✗ httpx is not listening"
        return 1
    fi
}

echo "=== Mythic Health Check ==="
echo "Time: $(date)"
echo ""

check_mythic_api
check_postgres
check_rabbitmq
check_httpx

echo ""
echo "Health check completed at $(date)"
