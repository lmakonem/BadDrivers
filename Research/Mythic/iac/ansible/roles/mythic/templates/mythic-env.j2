# Mythic Environment Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Database Configuration
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_HOST=postgres
POSTGRES_PORT={{ postgres_port }}

# Mythic Server Configuration
MYTHIC_HTTPS_PORT={{ mythic_https_port }}
MYTHIC_API_PORT={{ mythic_container_port }}
MYTHIC_WEBHOOK_PORT={{ mythic_webhook_port }}

# JWT and Authentication
MYTHIC_JWT_SECRET={{ vault_mythic_jwt_secret | default('change-me-in-production') }}
MYTHIC_JWT_EXPIRATION=3600

# RabbitMQ Configuration
RABBITMQ_USER=mythic
RABBITMQ_PASSWORD={{ vault_mythic_rabbitmq_password | default('mythic') }}
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_PATH=/var/log/mythic

# TLS Configuration
TLS_CERT_PATH={{ tls_cert_path }}
TLS_KEY_PATH={{ tls_key_path }}
TLS_VERIFY_CLIENT=false

# Backup Configuration
BACKUP_ENABLED={{ enable_backup | lower }}
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
BACKUP_SCHEDULE={{ backup_schedule }}

# Monitoring
MONITORING_ENABLED={{ enable_monitoring | lower }}
PROMETHEUS_PORT=9090

# HA Configuration
HA_ENABLED={{ enable_ha_replication | lower }}
HA_REPLICA_HOST={{ hostvars[groups.get('mythic_servers', [])[0]].ansible_host | default('localhost') }}
HA_REPLICA_PORT=5432

# Plugin Configuration
PLUGIN_DOCKER_HOST=unix:///var/run/docker.sock
PLUGIN_DOCKER_VERSION=latest

# Deployment Mode
DEPLOYMENT_MODE={{ deployment_mode | default('lab') }}
ENVIRONMENT={{ deployment_mode | default('lab') }}

# Feature Flags
FEATURE_VAULT_INTEGRATION={{ enable_vault_integration | lower }}
FEATURE_WEBHOOK_SIGNING=true
FEATURE_CALLBACK_ENCRYPTION=true

# Callback Configuration
CALLBACK_DOMAIN={% if 'redirectors' in group_names %}{{ hostvars[groups['redirectors'][0]].ansible_host | default('localhost') }}{% else %}localhost{% endif %}
CALLBACK_PORT=443
CALLBACK_PROTOCOL=https
