#!/bin/bash
# Mythic Log Collection Script
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

set -e

LOG_DIR="{{ mythic_base_path }}/logs"
BACKUP_DIR="/opt/backups/logs"
DATE=$(date +%Y%m%d_%H%M%S)

mkdir -p "$BACKUP_DIR"

echo "[*] Collecting Mythic logs..."

# Collect Docker logs
docker-compose -f {{ mythic_base_path }}/docker/docker-compose.yml logs --no-color > "$BACKUP_DIR/docker_$DATE.log" 2>&1 || true

# Collect system logs
tar -czf "$BACKUP_DIR/system_logs_$DATE.tar.gz" \
  /var/log/auth.log \
  /var/log/syslog \
  /var/log/nginx/access.log \
  /var/log/nginx/error.log \
  2>/dev/null || true

echo "[+] Logs collected to $BACKUP_DIR"
ls -lh "$BACKUP_DIR" | tail -5
