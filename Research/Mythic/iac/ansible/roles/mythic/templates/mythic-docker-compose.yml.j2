version: '{{ mythic_docker_compose_version }}'

services:
  postgres:
    image: "docker.io/itsafeature/mythic_postgres:latest"
    container_name: mythic_postgres
    environment:
      POSTGRES_USER: "{{ postgres_user }}"
      POSTGRES_PASSWORD: "{{ postgres_password }}"
      POSTGRES_DB: "{{ postgres_db }}"
    ports:
      - "{{ postgres_port }}:{{ postgres_port }}"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - /var/log/mythic:/var/log/postgresql
    networks:
      - mythic
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  mythic:
    image: "docker.io/itsafeature/mythic_mythic:latest"
    container_name: mythic_server
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: "{{ postgres_port }}"
      POSTGRES_USER: "{{ postgres_user }}"
      POSTGRES_PASSWORD: "{{ postgres_password }}"
      POSTGRES_DB: "{{ postgres_db }}"
      MYTHIC_HTTPS_PORT: "{{ mythic_https_port }}"
      MYTHIC_API_PORT: "{{ mythic_container_port }}"
    ports:
      - "{{ mythic_https_port }}:{{ mythic_https_port }}"
      - "{{ mythic_container_port }}:{{ mythic_container_port }}"
    volumes:
      - mythic_data:/opt/mythic/data
      - mythic_payloads:/opt/mythic/payloads
      - /var/log/mythic:/var/log/mythic
    networks:
      - mythic
    healthcheck:
      test: ["CMD-SHELL", "curl -sk https://localhost:{{ mythic_https_port }}/api || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3

  rabbitmq:
    image: "docker.io/itsafeature/mythic_rabbitmq:latest"
    container_name: mythic_rabbitmq
    environment:
      RABBITMQ_DEFAULT_USER: mythic
      RABBITMQ_DEFAULT_PASS: "{{ vault_mythic_rabbitmq_password | default('mythic') }}"
    ports:
      - "5672:5672"
      - "15672:15672"
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    networks:
      - mythic
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  httpx:
    image: "ghcr.io/mythicc2profiles/httpx:latest"
    container_name: mythic_httpx
    depends_on:
      - mythic
    environment:
      MYTHIC_SERVER: "mythic"
      MYTHIC_PORT: "{{ mythic_container_port }}"
    ports:
      - "82:7006"
    volumes:
      - /opt/mythic/c2_profiles/httpx:/app/config
      - /var/log/mythic/httpx:/var/log
    networks:
      - mythic
    healthcheck:
      test: ["CMD-SHELL", "nc -zv localhost 7006 2>&1 | grep -q succeeded || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3

volumes:
  postgres_data:
  mythic_data:
  mythic_payloads:
  rabbitmq_data:

networks:
  mythic:
    driver: bridge
    ipam:
      config:
        - subnet: 172.20.0.0/16
