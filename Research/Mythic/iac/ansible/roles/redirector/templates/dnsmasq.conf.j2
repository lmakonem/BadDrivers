# Dnsmasq Configuration for Mythic C2 DNS Spoofing
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Core Configuration
port={{ dnsmasq_port }}
listen-address={{ dnsmasq_listen_address }}
bind-interfaces
interface=*

# Domain Records
addn-hosts=/etc/dnsmasq.hosts

# Cache Configuration
cache-size={{ dnsmasq_cache_size }}
max-cache-ttl=3600
min-cache-ttl=300
neg-ttl=300

# Query and Logging
{% if dnsmasq_log_queries %}
log-queries=extra
log-facility={{ dnsmasq_log_facility }}
{% endif %}

# Performance Tuning
dns-forward-max=150
server-state-file=/var/lib/dnsmasq/dnsmasq.state

# DHCP is disabled (redirector only provides DNS)
dhcp-range=0.0.0.0,static

# Security
quiet-dhcp
quiet-ra
stop-dns-rebind
rebind-localhost-ok

# Upstream DNS (optional fallback)
server=8.8.8.8
server=8.8.4.4
server=1.1.1.1

# RFC 1918 Private Zones (don't forward these upstream)
server=/10.in-addr.arpa/127.0.0.1
server=/168.192.in-addr.arpa/127.0.0.1
server=/16.172.in-addr.arpa/127.0.0.1

# Local zones
local=/local/
server=/local/127.0.0.1

# RFC 4193 IPv6 ULA
server=/d.f.ip6.arpa/127.0.0.1

# Spoof records (C2 domains)
# These will be read from /etc/dnsmasq.hosts (managed by Ansible)

# Logging
log-async=10
log-dhcp

# PID file
pid-file=/var/run/dnsmasq.pid

# User
user=dnsmasq
