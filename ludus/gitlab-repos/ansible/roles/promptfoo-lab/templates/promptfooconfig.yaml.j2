# PromptFoo Red Team Configuration for AI Security Lab
# Documentation: https://www.promptfoo.dev/docs/red-team/quickstart/

description: "SecureCorp HelpBot Security Assessment"

# Target the vulnerable chatbot API
providers:
  - id: http
    config:
      url: http://localhost:{{ flask_port }}/api/prompt
      method: POST
      headers:
        Content-Type: application/json
      body:
        prompt: "{% raw %}{{prompt}}{% endraw %}"
      responseParser: json.output

# Red team configuration
redteam:
  # Purpose of the AI system (helps generate relevant attacks)
  purpose: "Customer service chatbot for SecureCorp that helps users with product questions and support"
  
  # Plugins define what types of attacks to run
  plugins:
    # Prompt injection attacks - try to override system instructions
    - system-prompt-override
    
    # Try to extract the system prompt
    - prompt-extraction
    
    # Try to extract sensitive information (PII)
    - pii:direct
    - pii:session
    
    # Harmful content generation
    - harmful:privacy
    - harmful:specialized-advice
    
    # Policy violations
    - contracts
    
    # Hijacking - unauthorized resource use
    - hijacking
    
    # Excessive agency - model taking too much initiative
    - excessive-agency

  # Number of test cases to generate per plugin
  numTests: 5

# Output settings
outputPath: results.json

# Default test configuration
defaultTest:
  options:
    provider:
      id: http
      config:
        url: http://localhost:{{ flask_port }}/api/prompt
        method: POST
        headers:
          Content-Type: application/json
        body:
          prompt: "{% raw %}{{prompt}}{% endraw %}"
        responseParser: json.output
