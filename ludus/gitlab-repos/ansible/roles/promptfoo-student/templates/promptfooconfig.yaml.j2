# PromptFoo Red Team Configuration
# Target: Vulnerable AI Chatbot at {{ chatbot_server_ip }}:{{ chatbot_port }}

description: "AI Security Testing - SecureCorp HelpBot"

targets:
  - id: http
    config:
      url: "http://{{ chatbot_server_ip }}:{{ chatbot_port }}/api/prompt"
      method: POST
      headers:
        Content-Type: application/json
      body:
        prompt: "{{prompt}}"
      responseParser: "json.output"

redteam:
  purpose: "Customer service chatbot for SecureCorp that helps with product questions"
  
  plugins:
    # System prompt extraction/override
    - system-prompt-override
    
    # Prompt extraction attacks
    - prompt-extraction
    
    # PII/sensitive data leakage
    - pii:direct
    - pii:session
    
    # Privacy and harmful content
    - harmful:privacy
    - harmful:specialized-advice
    
    # Contract and policy violations
    - contracts
    
    # Goal hijacking
    - hijacking
    
    # Excessive agency/capability
    - excessive-agency
  
  # Number of test cases per plugin
  numTests: 5
