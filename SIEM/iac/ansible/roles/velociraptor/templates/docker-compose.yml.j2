---
# Velociraptor Docker Compose
# Generated by Ansible

version: "3.8"

services:
  velociraptor:
    image: velocidex/velociraptor:latest
    container_name: velociraptor
    hostname: velociraptor
    restart: unless-stopped
    command: >
      --config /etc/velociraptor/server.config.yaml frontend
    volumes:
      - ./config/server.config.yaml:/etc/velociraptor/server.config.yaml:ro
      - ./data:/velociraptor
    ports:
      - "{{ velociraptor.frontend_port }}:8000"
      - "8001:8001"
      - "{{ velociraptor.gui_port }}:8889"
    networks:
      - {{ docker.network_name }}

networks:
  {{ docker.network_name }}:
    external: true
