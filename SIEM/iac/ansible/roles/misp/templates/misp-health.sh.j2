#!/bin/bash
# MISP Health Check Script
# Generated by Ansible

MISP_URL="https://localhost:8443"
API_KEY="{{ misp.api_key }}"

echo "[$(date)] Running MISP health check..."

# Check MISP API
VERSION=$(curl -sk "$MISP_URL/servers/getVersion" \
    -H "Authorization: $API_KEY" \
    -H "Accept: application/json" | jq -r '.version')

if [ -z "$VERSION" ] || [ "$VERSION" = "null" ]; then
    echo "[$(date)] MISP API check FAILED"
    exit 1
fi

# Check container health
for container in misp-core misp-db misp-redis misp-modules; do
    STATUS=$(docker inspect --format='{{ "{{" }}.State.Health.Status{{ "}}" }}' $container 2>/dev/null || echo "unknown")
    if [ "$STATUS" != "healthy" ] && [ "$STATUS" != "unknown" ]; then
        echo "[$(date)] Container $container unhealthy: $STATUS"
        docker restart $container
    fi
done

echo "[$(date)] MISP health check passed (version: $VERSION)"
