#!/bin/bash
# MISP Daily Feed Sync with Slack Notifications
# Generated by Ansible

MISP_URL="https://localhost:8443"
API_KEY="{{ misp.api_key }}"
SLACK_WEBHOOK="{{ slack.webhook_url }}"

echo "[$(date)] Starting MISP daily feed sync..."

# Trigger feed cache update
RESULT=$(curl -sk -X POST "$MISP_URL/feeds/cacheFeeds/all" \
    -H "Authorization: $API_KEY" \
    -H "Accept: application/json" 2>&1)

# Check result
if echo "$RESULT" | grep -q "Pull queued"; then
    # Get feed stats
    FEED_COUNT=$(curl -sk "$MISP_URL/feeds" \
        -H "Authorization: $API_KEY" \
        -H "Accept: application/json" | jq 'length')
    
    IOC_COUNT=$(curl -sk "$MISP_URL/attributes/attributeStatistics/type" \
        -H "Authorization: $API_KEY" \
        -H "Accept: application/json" | jq '[.[]] | add')
    
    # Send success notification
    curl -sk -X POST "$SLACK_WEBHOOK" \
        -H "Content-Type: application/json" \
        -d "{
            \"text\": \"MISP Daily Sync Complete\",
            \"attachments\": [{
                \"color\": \"good\",
                \"fields\": [
                    {\"title\": \"Feeds\", \"value\": \"$FEED_COUNT\", \"short\": true},
                    {\"title\": \"IOCs\", \"value\": \"$IOC_COUNT\", \"short\": true}
                ]
            }]
        }"
    
    echo "[$(date)] Sync complete: $FEED_COUNT feeds, $IOC_COUNT IOCs"
else
    # Send failure notification
    curl -sk -X POST "$SLACK_WEBHOOK" \
        -H "Content-Type: application/json" \
        -d "{
            \"text\": \"MISP Daily Sync FAILED\",
            \"attachments\": [{
                \"color\": \"danger\",
                \"text\": \"Check /var/log/misp-sync.log for details\"
            }]
        }"
    
    echo "[$(date)] Sync FAILED: $RESULT"
    exit 1
fi
