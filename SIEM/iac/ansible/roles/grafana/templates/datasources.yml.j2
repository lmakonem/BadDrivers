# Grafana Datasources Provisioning
# Generated by Ansible

apiVersion: 1

datasources:
  - name: Wazuh-Indexer
    type: elasticsearch
    uid: wazuh-indexer
    access: proxy
    url: https://{{ network.vm1_ip }}:9200
    basicAuth: true
    basicAuthUser: admin
    database: "wazuh-alerts-*"
    jsonData:
      esVersion: "8.0.0"
      tlsSkipVerify: true
      timeField: timestamp
    secureJsonData:
      basicAuthPassword: {{ wazuh.indexer.admin_password }}

  - name: Graylog-OpenSearch
    type: elasticsearch
    uid: graylog-opensearch
    access: proxy
    url: http://{{ network.vm2_ip }}:9201
    database: "graylog_*"
    jsonData:
      esVersion: "8.0.0"
      timeField: timestamp

  - name: MISP-Infinity
    type: yesoreyeram-infinity-datasource
    uid: misp-infinity
    access: proxy
    isDefault: false
    jsonData:
      auth_method: apiKey
      apiKeyKey: Authorization
      apiKeyValue: {{ misp.api_key }}
