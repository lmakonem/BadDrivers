#!/bin/bash
# Sync Graylog events to Wazuh Indexer for CoPilot SIEM view
# Generated by Ansible

GRAYLOG_OS="http://localhost:9201"
WAZUH_INDEXER="https://{{ network.vm1_ip }}:9200"
AUTH="admin:{{ wazuh.indexer.admin_password }}"
SYNC_HOURS="${1:-1}"

echo "[$(date)] Starting Graylog to Wazuh Indexer sync (last ${SYNC_HOURS}h)..."

# Calculate time range
if [ "$SYNC_HOURS" = "--full" ]; then
    TIME_RANGE="now-30d"
    echo "Running full sync (30 days)..."
else
    TIME_RANGE="now-${SYNC_HOURS}h"
fi

# Sync gl-events index
for index in "gl-events_0" "graylog_0"; do
    echo "Syncing $index..."
    
    # Get documents from Graylog OpenSearch
    DOCS=$(curl -s "$GRAYLOG_OS/$index/_search?size=1000" \
        -H "Content-Type: application/json" \
        -d "{\"query\":{\"range\":{\"timestamp\":{\"gte\":\"$TIME_RANGE\"}}}}" 2>/dev/null)
    
    # Extract hits and sync to Wazuh Indexer
    echo "$DOCS" | jq -c '.hits.hits[]' 2>/dev/null | while read -r hit; do
        DOC_ID=$(echo "$hit" | jq -r '._id')
        SOURCE=$(echo "$hit" | jq -c '._source')
        
        # Add syslog_type if not present
        if ! echo "$SOURCE" | jq -e '.syslog_type' >/dev/null 2>&1; then
            if echo "$SOURCE" | jq -e '.meraki_device' >/dev/null 2>&1; then
                SOURCE=$(echo "$SOURCE" | jq '. + {"syslog_type": "meraki"}')
            else
                SOURCE=$(echo "$SOURCE" | jq '. + {"syslog_type": "ossec"}')
            fi
        fi
        
        # Index to Wazuh Indexer
        curl -sk -X PUT "$WAZUH_INDEXER/$index/_doc/$DOC_ID" \
            -u "$AUTH" \
            -H "Content-Type: application/json" \
            -d "$SOURCE" >/dev/null 2>&1
    done
    
    COUNT=$(echo "$DOCS" | jq '.hits.total.value // .hits.total' 2>/dev/null)
    echo "Synced $COUNT documents from $index"
done

echo "[$(date)] Sync complete"
